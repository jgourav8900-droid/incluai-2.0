# ==============================================================================
# INCLUAI 2.0 Configuration
# ==============================================================================
PORT=5000
NODE_ENV=development

# Generate a unique secret before deploying: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Optional External AI Provider Keys (System will use internal Grounded RAG Engine if not provided)
# GEMINI_API_KEY=your_gemini_api_key_here
# Configurable Gemini Model (e.g. gemini-3.1-flash-lite, gemini-2.5-flash)
GEMINI_MODEL=gemini-3.1-flash-lite
# Gemini Live Voice Model (e.g. gemini-2.0-flash or gemini-2.0-flash-exp)
# GEMINI_LIVE_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=your_openai_api_key_here

# Optional MongoDB Connection String (System uses embedded atomic database if omitted)
# MONGODB_URI=mongodb://localhost:27017/incluai2

# Email Integration (Gmail / Microsoft Graph OAuth Credentials)
EMAIL_PROVIDER=mock
# GMAIL_CLIENT_ID=your_gmail_client_id
# GMAIL_CLIENT_SECRET=your_gmail_client_secret
